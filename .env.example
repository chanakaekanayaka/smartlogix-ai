# Copy this file to ".env" and fill in the values.
# ".env.example" is safe to commit; ".env" is not.

GROQ_API_KEY=your-groq-api-key-here

# --- Optional: Groq model override (defaults to openai/gpt-oss-20b) ---
# GROQ_MODEL=qwen/qwen3.8-27b

# --- Optional: security layer ---------------------------------------
# Signs session tokens. A dev key is auto-generated if this is unset.
# SMARTLOGIX_SECRET_KEY=generate-a-long-random-string
# Require a login token on POST /api/delivery (default: false).
# SMARTLOGIX_REQUIRE_AUTH=false
# Seeded admin account (default: admin / changeme123).
# SMARTLOGIX_ADMIN_USER=admin
# SMARTLOGIX_ADMIN_PASSWORD=change-this-please

# --- Optional: Retrieval Agent microservice -------------------------
# Base URL of the standalone Retrieval Agent service (agents/retrieval_service.py).
# The Coordinator and /api/chat call it over HTTP instead of importing it
# directly - this is the project's defined agent-to-agent communication
# protocol. Default assumes it runs on port 8001.
# SMARTLOGIX_RETRIEVAL_URL=http://localhost:8001
